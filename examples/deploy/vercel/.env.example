# Set in the Vercel project (Settings → Environment Variables). The Deploy button asks for the first two.

# Admin: settings and garbage collection. A long random string: openssl rand -hex 24
ATLAS_TOKEN=
# For people who look at results: they sign in with it as the password. openssl rand -hex 24
ATLAS_READ_TOKEN=

# Set by Vercel when the Blob store is connected. The store must be private.
# BLOB_READ_WRITE_TOKEN=

# Optional.
# ATLAS_TRUSTED_PUBLISHERS=github:my-org            # default: the GitHub owner this project was deployed from
# ATLAS_ANONYMOUS_READ=1                            # anyone with the URL may look (no read token needed)
# CRON_SECRET=                                      # lets the daily pass run garbage collection, once a policy is saved
