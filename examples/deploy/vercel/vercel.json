{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "functions": {
    "api/atlas.ts": {
      "maxDuration": 300,
      "includeFiles": "public/admin/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/atlas?__atlas_path=/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/api/atlas?__atlas_path=/admin"
    },
    {
      "source": "/:probe(healthz|readyz|llms\\.txt)",
      "destination": "/api/atlas?__atlas_path=/:probe"
    },
    {
      "source": "/((?!api/|assets/|admin/|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "17 4 * * *"
    }
  ],
  "outputDirectory": "public"
}
