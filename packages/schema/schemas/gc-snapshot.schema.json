{
  "$id": "https://github.com/crvouga/atlas/schemas/gc-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Delete eligible layers on a schedule. `false` keeps the policy but deletes nothing"
            },
            "maxAgeDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650,
              "description": "A superseded layer is eligible once it was recorded more than this many days ago"
            },
            "maxBytes": {
              "description": "Project storage budget in bytes or decimal units such as 10GB. Above budget the oldest eligible layers may be collected before their age limit.",
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^[1-9]\\d*(?:KB|MB|GB|TB)$"
                }
              ]
            },
            "attachments": {
              "description": "Expire captured attachments of superseded layers independently from their result history. The first matching rule sets the age. Protected statuses take precedence.",
              "type": "object",
              "properties": {
                "maxAgeDays": {
                  "type": "number",
                  "minimum": 0
                },
                "keepForStatus": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "branch": {
                        "type": "string"
                      },
                      "maxAgeDays": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "maxAgeDays"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "maxAgeDays"
              ],
              "additionalProperties": false
            },
            "keepLatest": {
              "default": 20,
              "description": "Always keep this many of the newest layers, however old, so recent history stays",
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "intervalHours": {
              "default": 24,
              "description": "How often the server applies the policy",
              "type": "number",
              "minimum": 1,
              "maximum": 720
            }
          },
          "required": [
            "enabled",
            "maxAgeDays"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "description": "Where the effective policy came from",
      "type": "string",
      "enum": [
        "env",
        "config",
        "saved",
        "none"
      ]
    },
    "saved": {
      "type": "boolean",
      "description": "Whether a policy exists in S3"
    },
    "lastRuns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "dryRun": {
            "type": "boolean"
          },
          "at": {
            "type": "string",
            "description": "When the pass finished, ISO 8601"
          },
          "candidates": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Layers the policy would delete"
          },
          "deletedLayers": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "deletedBlobs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "keptLayers": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "error": {
            "description": "Why the pass stopped early, when it did",
            "type": "string"
          },
          "strippedLayers": {
            "description": "Retained layers with newly expired attachment files, including planned expiry in a dry run",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "candidateBlobs": {
            "description": "Captured-file blobs only the deleted layers used: what a real pass deletes (and did delete, unless a layer could not be read). The same in a dry run. Absent from a server that predates it",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "candidateBytes": {
            "description": "Bytes of those blobs and of the deleted layers' manifests: what a real pass frees. The same in a dry run",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "deletedBytes": {
            "description": "Bytes a real pass removed; 0 for a dry run",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "project",
          "dryRun",
          "at",
          "candidates",
          "deletedLayers",
          "deletedBlobs",
          "keptLayers"
        ],
        "additionalProperties": {}
      },
      "description": "The most recent pass over each project, newest first; empty before the first pass"
    },
    "stateKey": {
      "type": "string",
      "description": "Where the user state lives in the bucket, relative to the configured prefix"
    },
    "currentPass": {
      "description": "The pass running now, or null. Absent from a server that predates passes",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{8,64}$"
            },
            "status": {
              "type": "string",
              "enum": [
                "running",
                "done",
                "failed"
              ],
              "description": "`running` until every project is collected; a pass that stops midway is continued by the next request, scheduled pass or step, never started over"
            },
            "dryRun": {
              "type": "boolean"
            },
            "startedAt": {
              "type": "string",
              "description": "ISO 8601"
            },
            "updatedAt": {
              "type": "string",
              "description": "When the pass last made progress, ISO 8601"
            },
            "finishedAt": {
              "description": "When it finished, or null while running",
              "type": [
                "string",
                "null"
              ]
            },
            "progress": {
              "type": "object",
              "properties": {
                "projects": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Projects the pass covers"
                },
                "projectsDone": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "project": {
                  "description": "The project being collected now, or null",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "phase": {
                  "description": "What the pass is doing in that project: `layers` (deleting superseded layers), `scan` (reading the layers that stay), `blobs` (deleting files only deleted layers used)",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "candidates": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Layers the policy deletes, in the projects reached so far"
                },
                "layersExamined": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "deletedLayers": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "deletedBlobs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "candidateBlobs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "candidateBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "deletedBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "projects",
                "projectsDone",
                "project",
                "phase",
                "candidates",
                "layersExamined",
                "deletedLayers",
                "deletedBlobs",
                "candidateBlobs",
                "candidateBytes",
                "deletedBytes"
              ],
              "additionalProperties": {}
            },
            "runs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "project": {
                    "type": "string"
                  },
                  "dryRun": {
                    "type": "boolean"
                  },
                  "at": {
                    "type": "string",
                    "description": "When the pass finished, ISO 8601"
                  },
                  "candidates": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Layers the policy would delete"
                  },
                  "deletedLayers": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "deletedBlobs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "keptLayers": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "error": {
                    "description": "Why the pass stopped early, when it did",
                    "type": "string"
                  },
                  "strippedLayers": {
                    "description": "Retained layers with newly expired attachment files, including planned expiry in a dry run",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "candidateBlobs": {
                    "description": "Captured-file blobs only the deleted layers used: what a real pass deletes (and did delete, unless a layer could not be read). The same in a dry run. Absent from a server that predates it",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "candidateBytes": {
                    "description": "Bytes of those blobs and of the deleted layers' manifests: what a real pass frees. The same in a dry run",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "deletedBytes": {
                    "description": "Bytes a real pass removed; 0 for a dry run",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "project",
                  "dryRun",
                  "at",
                  "candidates",
                  "deletedLayers",
                  "deletedBlobs",
                  "keptLayers"
                ],
                "additionalProperties": {}
              },
              "description": "One per project finished so far"
            },
            "error": {
              "description": "Why the pass failed, when it did",
              "type": "string"
            }
          },
          "required": [
            "id",
            "status",
            "dryRun",
            "startedAt",
            "updatedAt",
            "finishedAt",
            "progress",
            "runs"
          ],
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "revision",
    "policy",
    "saved",
    "lastRuns",
    "stateKey"
  ],
  "additionalProperties": {}
}
